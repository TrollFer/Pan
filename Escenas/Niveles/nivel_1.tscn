theme_override_fonts/font = ExtResource("2_lswwr")
theme_override_font_sizes/font_size = 64
text = "Pero todavía es harina,
antes debe convertirse
en masa y entrar en el horno "
metadata/_edit_use_anchors_ = true

[node name="TextEdit18" type="Label" parent="."]
offset_left = -3625.0
